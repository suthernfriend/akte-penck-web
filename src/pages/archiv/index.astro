---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";

const all = await getCollection("articles", ({ data }) => !data.draft);
const sorted = all.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// Gruppierung nach Jahr/Monat — visuelle Akten-Struktur statt Endlosliste.
type Group = { label: string; articles: typeof sorted };
const groups = sorted.reduce<Group[]>((acc, article) => {
  const label = article.data.date.toLocaleDateString("de-DE", {
    month: "long",
    year: "numeric",
  });
  const existing = acc.find((g) => g.label === label);
  if (existing) existing.articles.push(article);
  else acc.push({ label, articles: [article] });
  return acc;
}, []);
---

<BaseLayout title="Archiv" description="Alle bisher veroeffentlichten Meldungen zum Fall Penck.">
  <section class="pt-2 pb-6 border-b border-[var(--color-frame-line)]">
    <p class="text-xs uppercase tracking-[0.2em] text-[var(--color-frame-muted)]">Archiv</p>
    <h1 class="mt-2 font-[var(--font-frame-serif)] text-3xl sm:text-4xl">Alle Meldungen</h1>
    <p class="mt-3 text-[var(--color-frame-fg)]/80">
      Chronologisch absteigend. Filter (Publikation, Tags) folgt in Iteration 2.
    </p>
  </section>

  {sorted.length === 0 ? (
    <p class="mt-8 text-[var(--color-frame-muted)] italic">Noch keine Meldungen.</p>
  ) : (
    groups.map((group) => (
      <section class="mt-10">
        <h2 class="font-[var(--font-frame-serif)] text-lg text-[var(--color-frame-muted)] mb-4">
          {group.label}
        </h2>
        <ul class="grid gap-4 sm:gap-6 sm:grid-cols-2">
          {group.articles.map((article) => (
            <li>
              <ArticleCard article={article} />
            </li>
          ))}
        </ul>
      </section>
    ))
  )}
</BaseLayout>
