---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { withBase } from "../lib/url";

interface Props {
  title: string;
  description?: string;
  /**
   * Wenn true, wird der Hauptcontainer NICHT mit padding/max-width gewrappt,
   * damit Artikel-Layouts ihren eigenen Body-Container (z.B. weiss auf schwarz)
   * vollflaechig setzen koennen.
   */
  fullBleed?: boolean;
}

const { title, description, fullBleed = false } = Astro.props;
const siteTitle = "Akte Penck";
const fullTitle = title === siteTitle ? title : `${title} — ${siteTitle}`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}

    {/* Google Fonts — fuer Dossier-Frame und LVZ-Variante. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&family=Source+Sans+3:wght@400;600;800&family=Bodoni+Moda:ital,wght@0,400;0,700;1,400&family=Libre+Caslon+Display&family=Cormorant+Garamond:wght@500;700&display=swap"
    />

    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
  </head>
  <body>
    <SiteHeader />

    {fullBleed ? (
      <slot />
    ) : (
      <main class="mx-auto max-w-5xl px-4 py-10">
        <slot />
      </main>
    )}

    <SiteFooter />
  </body>
</html>
