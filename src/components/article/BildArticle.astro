---
// Stub fuer BILD-Layout — wird in zweiter Iteration ausgebaut
// (rote Kopfleiste, sehr fette Caps-Headline, gelber EXKLUSIV-Sticker, schmale Spalten).
import type { CollectionEntry } from "astro:content";

interface Props {
  article: CollectionEntry<"articles">;
  readingMinutes: number;
}

const { article } = Astro.props;
const { title, lead, date, author } = article.data;
const dateLabel = date.toLocaleDateString("de-DE", {
  day: "2-digit",
  month: "2-digit",
  year: "numeric",
});
---

<div class="bg-white text-black">
  <div class="bg-red-600 text-white">
    <div class="mx-auto max-w-3xl px-4 py-3">
      <span class="font-black tracking-tight text-2xl uppercase">BILD</span>
    </div>
  </div>

  <article class="mx-auto max-w-3xl px-4 py-8">
    <p class="text-[11px] uppercase tracking-widest text-red-600 font-bold mb-3">
      Stub — BILD-Layout folgt in Iteration 2
    </p>
    <h1 class="font-black uppercase text-3xl sm:text-5xl leading-[0.95] tracking-tight">
      {title}
    </h1>
    <p class="mt-4 text-base sm:text-lg font-semibold">{lead}</p>
    <p class="mt-3 text-xs text-zinc-500">{author} · {dateLabel}</p>
    <hr class="my-6 border-zinc-200" />
    <div class="prose-paper">
      <slot />
    </div>
  </article>
</div>
